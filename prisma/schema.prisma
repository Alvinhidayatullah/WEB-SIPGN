// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  username  String?  @unique
  email     String?  @unique
  password  String
  role         Role     @default(USER)
  
  profilSppgId String?  @unique
  profilSppg   ProfilSppg? @relation(fields: [profilSppgId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProfilSppg {
  id                          String   @id @default(uuid())
  idSppg                      String   @unique
  nomorBaVerval               String
  tanggalBaVerval             DateTime
  statusOperasional           String
  tanggalOperasional          DateTime
  kodeSppg                    String   @unique
  namaSppg                    String
  provinsi                    String
  kabKota                     String
  kecamatan                   String
  kelurahanDesa               String
  alamat                      String
  kodePos                     String
  posisiLatitude              Float?
  posisiLongitude             Float?
  jenisBangunan               String
  jenisSppg                   String

  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  // Relations
  user                        User?
  yayasan                     Yayasan?
  rekeningBank                RekeningBank?
  kasatpel                    Kasatpel?
  mitraEksternal              MitraEksternal?
  perwakilanYayasan           PerwakilanYayasan?
}

model Yayasan {
  id                          String     @id @default(uuid())
  profilSppgId                String     @unique
  profilSppg                  ProfilSppg @relation(fields: [profilSppgId], references: [id], onDelete: Cascade)
  
  namaYayasan                 String
  npwp                        String
  provinsi                    String
  kabKota                     String
  kecamatan                   String
  kelurahanDesa               String
  alamat                      String
  kodePos                     String
  email                       String
  teleponHp                   String?
}

model RekeningBank {
  id                          String     @id @default(uuid())
  profilSppgId                String     @unique
  profilSppg                  ProfilSppg @relation(fields: [profilSppgId], references: [id], onDelete: Cascade)
  
  namaBank                    String
  nomorRekening               String
  namaPemilikRekening         String
  namaBankVirtualAccount      String
  nomorVirtualAccount         String
  namaVirtualAccount          String
}

model Kasatpel {
  id                          String     @id @default(uuid())
  profilSppgId                String     @unique
  profilSppg                  ProfilSppg @relation(fields: [profilSppgId], references: [id], onDelete: Cascade)
  
  nama                        String
  email                       String
  noHp                        String
}

model MitraEksternal {
  id                          String     @id @default(uuid())
  profilSppgId                String     @unique
  profilSppg                  ProfilSppg @relation(fields: [profilSppgId], references: [id], onDelete: Cascade)
  
  jenisMitra                  String
  namaMitra                   String
  namaPimpinan                String
  noHp                        String
  email                       String?
  bentukDukungan              String
  provinsi                    String
  kabKota                     String
  kecamatan                   String
  kelurahanDesa               String
  alamat                      String
  kodePos                     String
}

model PerwakilanYayasan {
  id                          String     @id @default(uuid())
  profilSppgId                String     @unique
  profilSppg                  ProfilSppg @relation(fields: [profilSppgId], references: [id], onDelete: Cascade)
  
  namaPerwakilan              String
  nik                         String
  email                       String
  noHp                        String
}
